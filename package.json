{
  "name": "app-cibo",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply app-cibo --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-cibo --remote"
  },
  "description": "App Cibo: menù settimanale, spesa e dispensa per la famiglia",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "~4.1.11",
    "wrangler": "^4.149.0",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~4.1.11"
  },
  "private": true,
  "type": "module"
}
