{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-cibo",
  "account_id": "33b9a2554c759fce9a814a200654ddd5",
  "main": "src/server/index.ts",
  "routes": [{ "pattern": "atavola.lorenzodambrosio.com", "custom_domain": true }],
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-cibo",
      "database_id": "ffd10310-9e31-4f4a-9935-de895f0607ca",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": {
    // Dopo la mezzanotte italiana (anche con ora legale), elabora il giorno precedente.
    "crons": ["15 0 * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "AI_PROVIDER_DEFAULT": "claude",
    "CLAUDE_MODEL_WEEK": "claude-sonnet-5-5",
    "CLAUDE_MODEL_RECIPE": "claude-sonnet-5-5",
    "CLAUDE_MODEL_FAST": "claude-haiku-5-5",
    "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "EMAIL_FROM": "A Tavola <onboarding@resend.dev>"
    // Secret (wrangler secret put ...): ANTHROPIC_API_KEY, RESEND_API_KEY, BETTER_AUTH_SECRET
    // Opzionali: BETTER_AUTH_URL, ADMIN_EMAIL, BRAVE_SEARCH_API_KEY
  },
  "observability": { "enabled": true }
}
